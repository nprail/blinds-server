# Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# RF Settings
RF_REPEAT_COUNT=3

# Python interpreter path (use full path if not on $PATH)
PYTHON_PATH=python3

# GPIO wiring (BCM pin numbers)
# GPIO_TX_PIN=17   # FS1000A DATA pin  (default 17 = header pin 11)
# GPIO_RX_PIN=27   # RXB6 DATA pin     (default 27 = header pin 13)
