# Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# RF Settings
RF_FREQUENCY_HZ=433920000
RF_REPEAT_COUNT=3

# Python interpreter path (use full path if not on $PATH)
PYTHON_PATH=python3

# SX1278 SPI / GPIO wiring
SX1278_SPI_BUS=0
SX1278_SPI_DEVICE=0
SX1278_RESET_PIN=22
SX1278_DIO0_PIN=25
