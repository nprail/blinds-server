# Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# RF Settings
RF_FREQUENCY_HZ=433920000
RF_REPEAT_COUNT=3

# Python interpreter path (use full path if not on $PATH)
PYTHON_PATH=python3

# ── RF driver ──────────────────────────────────────────────────────────────────
# RF_DRIVER=sx1278    # SPI OOK via SX1278 (default)
# RF_DRIVER=e32       # UART LoRa via EBYTE E32

# SX1278 SPI / GPIO wiring (used when RF_DRIVER=sx1278)
SX1278_SPI_BUS=0
SX1278_SPI_DEVICE=0
SX1278_RESET_PIN=22
SX1278_DIO0_PIN=25

# EBYTE E32 UART settings (used when RF_DRIVER=e32)
# E32_UART_PORT=/dev/ttyS0
# E32_UART_BAUD=9600
# E32_M0_PIN=17
# E32_M1_PIN=27
# E32_AUX_PIN=22     # Optional: BCM GPIO pin wired to E32 AUX
